# Database
DATABASE_URL=postgresql://toko_user:toko_password@localhost:5432/monitoring_toko

# Postgres (used by docker-compose)
POSTGRES_USER=toko_user
POSTGRES_PASSWORD=toko_password
POSTGRES_DB=monitoring_toko
POSTGRES_PORT=5432

# Server
PORT=3001

# Better Auth
BETTER_AUTH_SECRET=super-secret-key-monitoring-toko-2026
BETTER_AUTH_URL=http://localhost:3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
